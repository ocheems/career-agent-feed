# --- Never commit credentials or secret-shaped files ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
config.local.yaml
config.local.yml
config.private.yaml
config.private.yml

# Runtime files generated by workflows (never intended for commit)
effective_config.yaml
public/index.html

# --- Python cruft ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
